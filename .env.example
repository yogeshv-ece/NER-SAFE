# ==============================================================================
# NER-SAFE: AI-Based Early Warning and Landslide Risk Monitoring System
# Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' for local runtime.
# NEVER commit real credentials, API keys, or passwords to version control.
# ==============================================================================

# Application Environment: development | staging | production
APP_ENV=development

# REST API & Web Server Port
PORT=8000

# Cookie Security (Set to 1 / true in production environments when HTTPS is enabled)
COOKIE_SECURE=0

# Allowed CORS Origins (Comma-separated list; in production restrict to authoritative domain)
ALLOWED_ORIGINS=*

# Initial Bootstrap Administrator (Used by bootstrap_admin.py for initial RBAC setup)
BOOTSTRAP_ADMIN_NAME=NER-SAFE System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@nersafe.gov.in
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisToStrongPassword123!
BOOTSTRAP_ADMIN_STATE=Meghalaya
BOOTSTRAP_ADMIN_ORG=Ministry of Development of North Eastern Region (MDoNER)

# ------------------------------------------------------------------------------
# Satellite & Remote Sensing Data Feeds (Optional for Offline / Demo Mode)
# ------------------------------------------------------------------------------

# Copernicus Data Space Ecosystem (CDSE) / Sentinel-1 SAR & Sentinel-2 Optical
CDSE_CLIENT_ID=your_cdse_client_id_here
CDSE_CLIENT_SECRET=your_cdse_client_secret_here
CDSE_S3_ACCESS_KEY=your_cdse_s3_access_key_here
CDSE_S3_SECRET_KEY=your_cdse_s3_secret_key_here

# JAXA GSMaP / GSMaP_NOW Near-Real-Time Hourly Rainfall FTP Ingestion
JAXA_GSMAP_HOST=ftp.eorc.jaxa.jp
JAXA_GSMAP_USER=your_jaxa_registered_email_here
JAXA_GSMAP_PASSWORD=your_jaxa_ftp_password_here

# NASA Earthdata (SMAP Soil Moisture L2 & GPM IMERG Ingestion)
EARTHDATA_USERNAME=your_earthdata_username_here
EARTHDATA_PASSWORD=your_earthdata_password_here

# India Meteorological Department (IMD) Mausam Weather API Client
IMD_API_KEY=your_imd_api_key_here

# Optional Google Drive Automated Manifest Archive Integration
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
